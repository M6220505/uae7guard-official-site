# Environment Variables Example
# Copy this to .env.local for development or add to your hosting provider settings.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Web3 / Blockchain ────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ── OpenAI (AI-powered analysis) ─────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Stripe (Payments) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# ── SendGrid (Email) ─────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=alerts@uae7guard.com

# ── Notification Engine ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Threat Intelligence ──────────────────────────────────
FORTA_API_KEY=your_forta_api_key_here
CHAINALYSIS_API_KEY=your_chainalysis_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── App Settings ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://uae7guard.com
