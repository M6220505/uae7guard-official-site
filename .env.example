# Environment Variables Example
# Copy this to .env.local for development or add to your hosting provider settings.

# Web3 Providers
# Required for wallet connection.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
# Optional: enables Alchemy-backed RPC transports for supported chains.
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
# Legacy fallbacks (supported temporarily):
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here
# NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_api_key_here

# Notification Engine
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Threat Intelligence
FORTA_API_KEY=your_forta_api_key_here

# App Settings
NEXT_PUBLIC_APP_URL=https://uae7guard.com

# Server-side API protection
# Leave empty for a public MVP. Set only when callers can send x-api-key.
ANALYZE_API_KEY=
UAE7GUARD_API_KEY=
ANALYZE_RATE_LIMIT_WINDOW_MS=60000
ANALYZE_RATE_LIMIT_MAX_REQUESTS=60
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=30

# Optional server-side live blockchain and threat intelligence
# Lower these if API responses feel slow; incomplete providers are skipped quickly.
BLOCKCHAIN_RPC_TIMEOUT_MS=3000
EXPLORER_API_TIMEOUT_MS=1800
ALCHEMY_API_KEY=your_server_side_alchemy_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimistic_etherscan_api_key
CHAINALYSIS_API_KEY=your_chainalysis_api_key
TRM_API_KEY=your_trm_api_key
